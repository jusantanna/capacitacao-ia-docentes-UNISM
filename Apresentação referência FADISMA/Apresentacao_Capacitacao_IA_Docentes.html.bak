  <section class="slide" data-slide="m2-7.3" data-topic="7/10 · Módulo 2 — Decomposição de tarefas">
    <div class="slide-inner">
      <span class="kicker">Tópico 7 de 10 · Módulo 2</span>
      <h2 class="slide-title">Modelo 4: <span class="accent">projetos grandes</span></h2>
      <div class="chat-demo">
        <div class="chat-bubble chat-bubble--user">
          <div class="chat-meta"><i data-lucide="send" class="chat-avatar-icon"></i><span>Prompt de decomposição</span></div>
